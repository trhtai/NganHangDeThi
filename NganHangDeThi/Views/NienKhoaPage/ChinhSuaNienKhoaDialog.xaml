<Window x:Class="NganHangDeThi.Views.NienKhoaPage.ChinhSuaNienKhoaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NganHangDeThi.Views.NienKhoaPage"
        mc:Ignorable="d"
        
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:NganHangDeThi.Converters"
        xmlns:vm="clr-namespace:NganHangDeThi.ViewModels.NienKhoaPage"
        d:DataContext="{d:DesignInstance vm:ChinhSuaNienKhoaViewModel}"
        Title="{Binding DialogTitle}"
        Width="420" MinHeight="250" SizeToContent="Height"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- TenNienKhoa TextBox -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- Cancel and Save button -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Title-->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Margin="0,0,0,4">
                <Run Text="Tên niên khóa"/>
                <Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
            </TextBlock>
            <hc:TextBox x:Name="TenNienKhoaTextBox"
                    Text="{Binding TenNienKhoa, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    hc:InfoElement.Placeholder="VD: 2020-2021..."
                    MaxLength="200"
                    Style="{StaticResource TextBoxExtend}"/>

            <TextBlock Text="{Binding DuplicateWarning}"
                   Foreground="{DynamicResource DangerBrush}"
                   FontSize="11" Margin="2,4,0,0"
                   Visibility="{Binding DuplicateWarning, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

            <TextBlock Text="{Binding TenNienKhoaLength, StringFormat={}{0}/50 ký tự}"
                   HorizontalAlignment="Right"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!--Action buttons-->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" Width="90" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ButtonDefault}"
                    IsCancel="True"/>

            <Button Content="Lưu"
                    Width="90"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
