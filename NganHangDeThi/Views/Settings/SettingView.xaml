<UserControl x:Class="NganHangDeThi.Views.Settings.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NganHangDeThi.Views.Settings"
             mc:Ignorable="d"
             
             xmlns:vm="clr-namespace:NganHangDeThi.ViewModels.Settings"
             d:DataContext="{d:DesignInstance vm:SettingViewModel}"
             Width="800"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:NganHangDeThi.Converters"
             xmlns:comp="clr-namespace:NganHangDeThi.Views.Components"
             Background="{DynamicResource RegionBrush}">

    <UserControl.Resources>
        <conv:MyBoolToVisibilityConverter x:Key="MyBoolToVisibilityConverter"/>
    </UserControl.Resources>

    <!--Dùng Grid để các Control đè lên nhau-->
    <Grid>
        <StackPanel Margin="24">

            <TextBlock Text="Thiết lập chung" FontSize="20" FontWeight="Bold" Margin="0 0 0 16"/>

            <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hiện hộp thoại xác nhận khi thoát ứng dụng" FontWeight="SemiBold"/>
                        <TextBlock Text="Khi tắt, ứng dụng sẽ đóng ngay lập tức mà không hỏi lại."
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0 4 0 0"/>
                    </StackPanel>

                    <ToggleButton Grid.Column="1"
                          IsChecked="{Binding ShowExitConfirm}"
                          Style="{StaticResource ToggleButtonSwitch}"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Margin="0 10 0 0" Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Định dạng ngày giờ" FontWeight="SemiBold"/>
                        <TextBlock Text="Cách hiển thị ngày tháng trên toàn bộ các bảng dữ liệu."
                                Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0 4 0 0"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                            ItemsSource="{Binding AvailableDateFormats}"
                            SelectedValue="{Binding SelectedDateFormat}"
                            SelectedValuePath="Format"
                            DisplayMemberPath="DisplayName"
                            VerticalAlignment="Center"
                            Style="{StaticResource ComboBoxExtend}"/>
                </Grid>
            </Border>

            <Button x:Name="CloseButton"
                    Content="Đóng" Width="90" Margin="0 10 0 0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ButtonDefault}"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
        <comp:LoadingOverlay Visibility="{Binding IsLoading, Converter={StaticResource MyBoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
