<Window x:Class="NganHangDeThi.Views.LopPage.ChinhSuaLopDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NganHangDeThi.Views.LopPage"
        mc:Ignorable="d"
        
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:NganHangDeThi.Converters"
        xmlns:vm="clr-namespace:NganHangDeThi.ViewModels.LopPage"
        d:DataContext="{d:DesignInstance vm:ChinhSuaLopViewModel}"
        Title="{Binding DialogTitle}"
        Width="420" MinHeight="250" SizeToContent="Height"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- MaLop TextBox -->
            <RowDefinition Height="Auto"/>
            <!-- Khoa ComboBox -->
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
            
            <!-- Cancel and Save button -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Title-->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <!--MaLop-->
        <StackPanel Grid.Row="1">
            <TextBlock Margin="0,0,0,4">
                <Run Text="Mã lớp"/>
                <Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
            </TextBlock>
            <hc:TextBox x:Name="MaLopTextBox"
                    Text="{Binding MaLop, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    hc:InfoElement.Placeholder="VD: DH20TIN01..."
                    MaxLength="20"
                    Style="{StaticResource TextBoxExtend}"/>

            <TextBlock Text="{Binding DuplicateWarning}"
                   Foreground="{DynamicResource DangerBrush}"
                   FontSize="11" Margin="2,4,0,0"
                   Visibility="{Binding DuplicateWarning, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

            <TextBlock Text="{Binding MaLopLength, StringFormat={}{0}/20 ký tự}"
                   HorizontalAlignment="Right"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Chọn Khoa -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,4">
                <Run Text="Thuộc khoa"/>
                <Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
            </TextBlock>
            <ComboBox ItemsSource="{Binding DanhSachKhoa}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="TenKhoa"
                      SelectedValue="{Binding SelectedKhoaId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                      hc:InfoElement.Placeholder="-- Chọn khoa quản lý --"
                      Style="{StaticResource ComboBoxExtend}" />
        </StackPanel>

        <!--Action buttons-->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" Width="90" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ButtonDefault}"
                    IsCancel="True"/>
            <!--Disable ngay khi bấm để tránh double-click trong lúc lưu, đúng chuẩn
            "Inline spinner nhỏ trên nút"-->
            <Button Content="Lưu"
                    Width="90"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
