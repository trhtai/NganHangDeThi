<UserControl x:Class="NganHangDeThi.Views.Dialogs.XacNhanThoatDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NganHangDeThi.Views.Dialogs"
             mc:Ignorable="d" 
             
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Border CornerRadius="10" Width="380" Padding="24"
            Background="{DynamicResource RegionBrush}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                <Icon:PackIconMaterial Kind="ExitToApp" Width="22" Height="22"
                                        Foreground="{DynamicResource PrimaryBrush}" Margin="0 0 8 0"/>
                <TextBlock Text="Xác nhận thoát" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Bạn có chắc chắn muốn thoát ứng dụng không?"
                       TextWrapping="Wrap" Margin="0 0 0 16"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <CheckBox x:Name="DontAskAgainCheckBox"
                      Content="Không hiển thị lại"
                      Margin="0 0 0 20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Hủy"
                        Width="90" Margin="0 0 8 0"
                        Style="{StaticResource ButtonDefault}"
                        Click="CancelButton_Click"/>
                <Button x:Name="ConfirmButton" Content="Thoát"
                        Width="90"
                        Style="{StaticResource ButtonPrimary}"
                        Click="ConfirmButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
